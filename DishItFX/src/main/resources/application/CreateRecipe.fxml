<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="home-page" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controllers.CreateRecipeController">
   <top>
      <fx:include source="Header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" vbarPolicy="AS_NEEDED">
         <content>
            <StackPane alignment="TOP_CENTER">
               <children>
            <VBox maxWidth="760.0" spacing="18.0" styleClass="form-panel">
               <padding>
                  <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
               </padding>
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="heading" text="CREATE A RECIPE" />
                        <Label styleClass="form-description" text="Add the details so you can find and manage it later." />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Recipe name" />
                        <TextField fx:id="recipeNameField" promptText="e.g. Roasted tomato pasta" styleClass="form-field" />
                     </children>
                  </VBox>
                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="form-label" text="Meal type" />
                              <ChoiceBox fx:id="categoryChoiceBox" maxWidth="Infinity" styleClass="form-field" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="form-label" text="Prep time (minutes)" />
                              <TextField fx:id="prepTimeField" promptText="15" styleClass="form-field" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="form-label" text="Cook time (minutes)" />
                              <TextField fx:id="cookTimeField" promptText="20" styleClass="form-field" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Ingredients (one per line)" />
                        <TextArea fx:id="ingredientsField" prefRowCount="5" promptText="2 cups tomatoes&#10;1 tbsp olive oil" styleClass="form-field" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Instructions (one step per line)" />
                        <TextArea fx:id="instructionsField" prefRowCount="5" promptText="Preheat the oven...&#10;Roast until tender..." styleClass="form-field" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Notes (optional)" />
                        <TextArea fx:id="notesField" prefRowCount="3" promptText="Serving tips or substitutions" styleClass="form-field" wrapText="true" />
                     </children>
                  </VBox>
                  <Label fx:id="formFeedback" styleClass="form-feedback" wrapText="true" />
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button onAction="#goToMyRecipes" styleClass="secondary-button" text="Cancel" />
                        <Button onAction="#saveRecipe" styleClass="primary-button" text="Save recipe" />
                     </children>
                  </HBox>
               </children>
            </VBox>
               </children>
            </StackPane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
