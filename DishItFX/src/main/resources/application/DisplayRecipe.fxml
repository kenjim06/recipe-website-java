<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #F6F3EC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controllers.DisplayRecipeController">
   <top>
      <fx:include source="Header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="recipe-scroll" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox maxWidth="Infinity" minWidth="0.0" spacing="18.0">
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
               <children>
                  <VBox spacing="8.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label fx:id="recipeNameLabel" maxWidth="Infinity" styleClass="heading" text="Select a recipe" wrapText="true" HBox.hgrow="ALWAYS" />
                              <Button fx:id="favoriteButton" onAction="#toggleFavorite" styleClass="favorite-star-button recipe-detail-favorite" text="☆" />
                           </children>
                        </HBox>
                        <Label fx:id="categoryLabel" styleClass="recipe-category" text="" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label styleClass="recipe-time" text="Prep time:" />
                              <Label fx:id="prepTimeLabel" styleClass="recipe-time" text="--" />
                              <Label styleClass="recipe-time" text="Cook time:" />
                              <Label fx:id="cookTimeLabel" styleClass="recipe-time" text="--" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <StackPane fx:id="recipeImageFrame" maxWidth="Infinity" minHeight="0.0" minWidth="0.0" prefWidth="640.0" styleClass="recipe-detail-image-box">
                     <children>
                        <ImageView fx:id="recipeImageView" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <VBox styleClass="recipe-detail-section">
                     <children>
                        <Label styleClass="filter-heading" text="INGREDIENTS" />
                        <Label fx:id="ingredientsText" maxWidth="Infinity" styleClass="recipe-detail-text" text="No ingredients available yet." wrapText="true" />
                     </children>
                  </VBox>
                  <VBox styleClass="recipe-detail-section">
                     <children>
                        <Label styleClass="filter-heading" text="INSTRUCTIONS" />
                        <Label fx:id="instructionsText" maxWidth="Infinity" styleClass="recipe-detail-text" text="No instructions available yet." wrapText="true" />
                     </children>
                  </VBox>
                  <VBox styleClass="recipe-detail-section">
                     <children>
                        <Label styleClass="filter-heading" text="NOTES" />
                        <Label fx:id="notesText" maxWidth="Infinity" styleClass="recipe-detail-text" text="No notes." wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
